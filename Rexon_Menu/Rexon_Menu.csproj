    <Reference Include="UnityEngine.XRModule"><HintPath>$(GorillaManaged)\UnityEngine.XRModule.dll</HintPath></Reference>
    <Reference Include="UnityEngine.AudioModule"><HintPath>$(GorillaManaged)\UnityEngine.AudioModule.dll</HintPath></Reference>
    <Reference Include="UnityEngine.UnityWebRequestModule"><HintPath>$(GorillaManaged)\UnityEngine.UnityWebRequestModule.dll</HintPath></Reference>
    <Reference Include="UnityEngine.ParticleSystemModule"><HintPath>$(GorillaManaged)\UnityEngine.ParticleSystemModule.dll</HintPath></Reference>
    <Reference Include="PhotonVoice"><HintPath>$(GorillaManaged)\PhotonVoice.dll</HintPath></Reference>
