    <Reference Include="UnityEngine.IMGUIModule"><HintPath>$(GorillaManaged)\UnityEngine.IMGUIModule.dll</HintPath></Reference>
    <Reference Include="BepInEx"><HintPath>$(GorillaBepInEx)\BepInEx.dll</HintPath></Reference>
